pkgname=libflucid-demo
version=1.0
revision=1
arch=$(uname -m)
short_desc="Tiny shared library (tests shlib provides/requires)"
maintainer="FlucidOS <flucidos@localhost>"
license="BSD-2-Clause"
homepage="https://github.com/FlucidOS/flappy"
shlib_provides="libflucid-demo.so.1"

do_build() {
	printf 'const char *flucid_demo_msg(void){return "hello from libflucid-demo";}\n' > demo.c
	${CC:-cc} -shared -fPIC -Wl,-soname,libflucid-demo.so.1 -o libflucid-demo.so.1 demo.c
}

do_install() {
	mkdir -p "$DESTDIR/usr/lib"
	install -m755 libflucid-demo.so.1 "$DESTDIR/usr/lib/libflucid-demo.so.1"
	ln -s libflucid-demo.so.1 "$DESTDIR/usr/lib/libflucid-demo.so"
}
